# 测试配置；不得包含密码。生产使用独立项目名、经审核的不可变镜像摘要。
WB_COMPOSE_PROJECT=automation-workbench-dev
COMPOSE_PROFILES=bundled-db
WB_IMAGE=automation-workbench:dev
WB_RELEASE_VERSION=dev
WB_VCS_REF=unknown
WB_ENV=development
WB_BIND_ADDRESS=127.0.0.1
WB_PORT=18080
WB_BASE_PATH=
# 外部可访问的站点根地址；不含子路径，配置后成功通知才会附带登录查看链接。
WB_PUBLIC_BASE_URL=
WB_DISPATCH_ENABLED=true
WB_DATABASE_CONNECT_ATTEMPTS=30
WB_DATABASE_CONNECT_INTERVAL_SECONDS=2
WB_DATABASE_POOL_SIZE=5
WB_DATABASE_MAX_OVERFLOW=5
WB_DATABASE_POOL_TIMEOUT_SECONDS=30
# 输入存储保护：单文件50MB、单批次200个/500MB、单项目10GB/10000批次。
WB_MAX_UPLOAD_BYTES=52428800
WB_MAX_BATCH_FILES=200
WB_MAX_BATCH_BYTES=524288000
WB_MAX_PROJECT_INPUT_BYTES=10737418240
WB_MAX_PROJECT_OPEN_BATCHES=200
WB_MAX_PROJECT_PROGRAM_BYTES=5368709120
WB_ADMIN_USERNAME=admin
WB_ADMIN_DISPLAY_NAME=平台管理员
