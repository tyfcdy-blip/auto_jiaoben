{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["period", "mapping_file", "bill_files"],
  "properties": {
    "period": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "mapping_file": {"type": "string", "minLength": 1, "maxLength": 180},
    "bill_files": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 180}}
  }
}
