{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["id","project_id","purpose","path","limit","expires_at","config_revision","output_config_revision","allowed_roots"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-zA-Z0-9_-]{1,128}$"},
    "project_id":{"type":"string","pattern":"^[a-zA-Z0-9_-]{1,128}$"},
    "purpose":{"enum":["input","output"]},
    "path":{"type":"string","minLength":1,"maxLength":4096},
    "limit":{"type":"integer","minimum":1,"maximum":200},
    "offset":{"type":"integer","minimum":0,"maximum":10000},
    "expires_at":{"type":"number","minimum":0},
    "config_revision":{"type":"integer","minimum":0},
    "output_config_revision":{"type":"integer","minimum":0},
    "allowed_roots":{"type":"array","maxItems":30,"items":{"type":"string","minLength":1,"maxLength":4096}}
  }
}
