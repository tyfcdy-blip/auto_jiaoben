{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "run_id", "attempt_id", "operation", "parameters", "input_manifest", "output_dir", "state_dir", "cancel_file"],
  "properties": {
    "protocol_version": {"const": "1"}, "run_id": {"type": "string"}, "attempt_id": {"type": "string"},
    "operation": {"type": "string"}, "parameters": {"type": "object"},
    "output_dir": {"type": "string"}, "state_dir": {"type": "string"}, "cancel_file": {"type": "string"},
    "input_manifest": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "path", "sha256"], "properties": {
        "name": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }}
  }
}
